# Copy to .env and adjust. Every setting here is read from process.env, after
# src/server.ts loads dotenv on its first line.

# The port the API listens on. Defaults to 4000.
PORT=4000

# development | test | production. Defaults to development.
NODE_ENV=development

# The PostgreSQL database (Neon). Take the pooled connection string from the
# Neon dashboard; each environment gets its own branch, so development never
# writes to production's rows.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
